# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Mini App URL (Vercel production or localhost tunnel)
MINI_APP_URL=https://v4elite.vercel.app

# Notification API port (default: 4000)
API_PORT=4000

# Shared secret for the HTTP notification API (change this!)
API_SECRET=elite_force_secret_2024

# Firebase Admin SDK Credentials (Required for Render deployment)
# Option 1: Full JSON string or Base64 string of service account file
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"mini-telegram-app-c0fb4",...}

# Option 2: Individual variables
# FIREBASE_PROJECT_ID=mini-telegram-app-c0fb4
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mini-telegram-app-c0fb4.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary (Optional, for media storage)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Users collection
    match /users/{userId} {
      allow read, write: if true;
    }
    match /users/{document=**} {
      allow read, write: if true;
    }

    // 2. Admin settings (Global configuration)
    match /adminSettings/{document=**} {
      allow read, write: if true;
    }

    // 3. Official Missions & Tasks configuration
    match /tasks/{document=**} {
      allow read, write: if true;
    }
    match /taskCompletions/{document=**} {
      allow read, write: if true;
    }

    // 4. User task completions
    match /userTasks/{document=**} {
      allow read, write: if true;
    }

    // 5. Referrals & Tiers
    match /referrals/{document=**} {
      allow read, write: if true;
    }
    match /referral_claim_tiers/{document=**} {
      allow read, write: if true;
    }
    match /support_chats/{document=**} {
      allow read, write: if true;
    }

    // 6. Withdraw and Deposit requests & Transactions
    match /withdrawRequests/{document=**} {
      allow read, write: if true;
    }
    match /depositRequests/{document=**} {
      allow read, write: if true;
    }
    match /transactions/{document=**} {
      allow read, write: if true;
    }

    // 7. Audit logs & security logs & histories
    match /auditLogs/{document=**} {
      allow read, write: if true;
    }
    match /securityEvents/{document=**} {
      allow read, write: if true;
    }
    match /fraudLogs/{document=**} {
      allow read, write: if true;
    }
    match /authenticationLogs/{document=**} {
      allow read, write: if true;
    }
    match /notificationLogs/{document=**} {
      allow read, write: if true;
    }
    match /pointHistory/{document=**} {
      allow read, write: if true;
    }
    match /deductionHistory/{document=**} {
      allow read, write: if true;
    }

    // 8. X (Twitter) Verification System
    match /xUsers/{document=**} {
      allow read, write: if true;
    }
    match /xUserIds/{document=**} {
      allow read, write: if true;
    }

    // 9. P2P Task Market Engine
    match /marketTasks/{document=**} {
      allow read, write: if true;
    }
    match /taskSubmissions/{document=**} {
      allow read, write: if true;
    }
    match /taskEscrow/{document=**} {
      allow read, write: if true;
    }
    match /taskAnalytics/{document=**} {
      allow read, write: if true;
    }

    // 10. Fallback match for any current or future collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
